{
  "brand": {
    "name": "destination.one",
    "presentation_name": "one.design",
    "version": "1.0"
  },
  "colors": {
    "primary": "#a8db20",
    "secondary": "#00cfc0",
    "text_dark": "#000000",
    "text_light": "#ffffff",
    "text_muted": "#555555",
    "gradient_light": "#dcefa6",
    "gradient_mid": "#c3ebc4",
    "gradient_dark": "#a6e4da"
  },
  "gradients": {
    "circle_default": "linear-gradient(135deg, #dcefa6 0%, #c3ebc4 45%, #a6e4da 100%)"
  },
  "typography": {
    "font_family": "Fira Sans",
    "font_weights": {
      "regular": 400,
      "medium": 600,
      "bold": 700,
      "extra_bold": 800,
      "black": 900
    },
    "sizes": {
      "h1_xl": {
        "size_px": 150,
        "weight": 900,
        "line_height": 1.0,
        "letter_spacing": "-0.5px"
      },
      "h1": {
        "size_px": 108,
        "weight": 900,
        "line_height": 1.02,
        "letter_spacing": "-0.5px"
      },
      "h2": {
        "size_px": 52,
        "weight": 800,
        "line_height": 1.3,
        "letter_spacing": "0px"
      },
      "h3": {
        "size_px": 44,
        "weight": 800,
        "line_height": 1.15,
        "letter_spacing": "0px"
      },
      "intro": {
        "size_px": 48,
        "weight": 600,
        "line_height": 1.35,
        "letter_spacing": "0px"
      },
      "body": {
        "size_px": 28,
        "weight": 600,
        "line_height": 1.3,
        "letter_spacing": "0px"
      },
      "label": {
        "size_px": 20,
        "weight": 600,
        "line_height": 1.2,
        "letter_spacing": "0px"
      },
      "small": {
        "size_px": 18,
        "weight": 500,
        "line_height": 1.2,
        "letter_spacing": "0px"
      }
    }
  },
  "spacing": {
    "micro": "8px",
    "small": "14px",
    "medium": "28px",
    "large": "44px",
    "xl": "60px",
    "xxl": "90px"
  },
  "layout": {
    "slide_width": 1920,
    "slide_height": 1080,
    "padding": {
      "vertical": "60px",
      "horizontal": "120px"
    },
    "text_to_image_spacing": "60px",
    "between_elements": "28px-44px"
  },
  "circles": {
    "size_small": "900px",
    "size_medium": "1100px",
    "size_large": "1300px",
    "gradient": "linear-gradient(135deg, #dcefa6 0%, #c3ebc4 45%, #a6e4da 100%)",
    "opacity": 1.0,
    "z_index": 0
  },
  "neon_line": {
    "color": "#a8db20",
    "stroke_width": "32px",
    "opacity": 1.0,
    "glow_filter": true,
    "glow_stddeviation": 2
  },
  "badge": {
    "size": "120px",
    "position": "bottom-right",
    "offset_x": "30px",
    "offset_y": "30px",
    "logo_size": "60px",
    "title_size": "24px",
    "subtitle_size": "18px"
  },
  "illustrations": {
    "style": "one-lime-line",
    "line_color": "#000000",
    "gradient": "linear-gradient(135deg, #dcefa6 0%, #c3ebc4 45%, #a6e4da 100%)",
    "sizes": {
      "icon": "80px-200px",
      "medium": "300px-600px",
      "badge": "120px-150px"
    },
    "format_preferred": "svg",
    "format_fallback": "png"
  },
  "responsive": {
    "primary_viewport": "1920x1080",
    "preview_scale": 0.5,
    "breakpoints": {
      "desktop": 1920,
      "tablet": 1024,
      "mobile": 768
    }
  },
  "quality_checklist": [
    "Headline: 108px or 150px",
    "Subtitle: 52px",
    "Bullets: 28px",
    "Max 3-4 bullets per slide",
    "Text-to-Image spacing: 60px+",
    "Circle accent placed (not behind text)",
    "Badge in bottom-right",
    "Colors: Hellgrün + Türkis only",
    "Font: Fira Sans only",
    "Illustration/Image high-quality",
    "Asymmetrical layout (not symmetric)"
  ]
}
